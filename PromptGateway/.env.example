# Copy to .env and adjust for your environment.

APP_NAME=Enterprise Prompt Gateway
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

HOST=0.0.0.0
PORT=8000

POLICY_PATH=policy.yaml
LOG_DIR=logs
AUDIT_DB_PATH=logs/audit.db

# Point at your Ollama instance. Inside docker-compose this is the
# "ollama" service name; on bare metal it is typically localhost.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://192.168.1.5:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT_SECONDS=15

CORS_ALLOW_ORIGINS=*

# Optional: require an API key on all /api/v1/* routes.
REQUIRE_API_KEY=false
API_KEY=
