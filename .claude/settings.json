{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/prompt_gateway_check.py\"",
            "timeout": 55,
            "statusMessage": "Screening prompt via PromptGateway..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_end_wiki_flag.py\"",
            "timeout": 10,
            "statusMessage": "Queuing session for wiki review..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session_start_wiki_review.py\"",
            "timeout": 10,
            "statusMessage": "Checking for pending wiki reviews..."
          }
        ]
      }
    ]
  }
}
